# Copy this file to .env and fill it in. Lines starting with # are ignored.

# Required. Anyone who knows this can upload, so make it long and random, for example the
# output of:  openssl rand -hex 32
UPLOAD_TOKEN=change-me

# ---------------------------------------------------------------------------------------
# Pick ONE setup and keep its lines (the README explains each one).
# ---------------------------------------------------------------------------------------

# A) Local network or Tailscale: the server is reached directly on port 8080.
TRUST_PROXY=none
PUBLISH=8080

# B) Own domain with HTTPS through Caddy:
#COMPOSE_PROFILES=caddy
#SHARE_DOMAIN=share.example.com
#TRUST_PROXY=proxy
#PUBLISH=127.0.0.1:8080

# C) Cloudflare Tunnel:
#COMPOSE_PROFILES=cloudflare
#TRUST_PROXY=cloudflare
#PUBLISH=127.0.0.1:8080

# ---------------------------------------------------------------------------------------
# Optional limits (these are the defaults).
# ---------------------------------------------------------------------------------------
#TTL_HOURS=24                      # how long a file is kept if the sender doesn't choose
#MAX_TTL_HOURS=72                  # the longest a sender may choose
#MAX_UPLOAD_MB=500                 # largest single file
#RATE_LIMIT_MB_PER_HOUR=3072       # upload volume per client per hour
#RATE_LIMIT_REQUESTS_PER_HOUR=300  # requests per client per hour
#MAX_STORAGE_GB=20                 # total disk space for files waiting to be downloaded
