<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same exclusions as backup_rules.xml, for cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="resonance_secure_prefs.xml" />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="resonance_secure_prefs.xml" />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
